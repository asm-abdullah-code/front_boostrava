Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Direct serve existing files or directory index
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 2. Dynamic Fallback for any single blog post: /blog/:slug/
RewriteCond %{REQUEST_URI} ^/blog/([^/]+)/?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^blog/([^/]+)/?$ /blog/index.html [L]

# 3. Dynamic Fallback for category / tag: /blog/category/:slug/
RewriteCond %{REQUEST_URI} ^/blog/(category|tag)/([^/]+)/?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^blog/(category|tag)/([^/]+)/?$ /blog/index.html [L]

# 4. Standard directory / page rewrite
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

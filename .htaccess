Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. If exact file or directory index exists, serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 2. Dynamic Fallback for any blog post URL: /blog/{slug} or /blog/{slug}/
# If a specific /blog/{slug}/index.html does not exist on disk, serve /blog/template/index.html
RewriteCond %{REQUEST_URI} ^/blog/([^/]+)/?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^blog/([^/]+)/?$ /blog/template/index.html [L]

# 3. If a directory exists but has no index.html, serve matching .html file
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/?$ $1.html [L]

# 4. Extensionless URLs -> .html (when the .html file exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

